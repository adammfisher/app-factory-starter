{
  "gate": [
    {
      "name": "typecheck",
      "cmd": "npx tsc --noEmit"
    },
    {
      "name": "infra-policy",
      "cmd": "node factory/infra.mjs check"
    },
    {
      "name": "infra-validate",
      "cmd": "if [ -d infra ]; then terraform -chdir=infra init -backend=false -input=false -no-color && terraform -chdir=infra validate -no-color; fi"
    },
    {
      "name": "spec",
      "cmd": "npx jest --ci {tests}"
    },
    {
      "name": "regression",
      "cmd": "npx jest --ci"
    },
    {
      "name": "web",
      "cmd": "npx expo export --platform web --output-dir dist-web"
    }
  ],
  "ladder": {
    "retry": 2,
    "repair": 1
  },
  "budget": {
    "maxCostUsdPerRun": 20,
    "maxTurns": 40,
    "maxContinuations": 2
  },
  "agent": {
    "cmd": "claude",
    "permissionMode": "acceptEdits",
    "extraFlags": [
      "--permission-prompts",
      "none"
    ],
    "models": {},
    "progress": "json"
  },
  "locked": [
    "factory/",
    ".claude/"
  ],
  "plan": {
    "maxFeaturesPerRequirement": 4
  }
}
